                     lambda_depth = self.conf.loss.lambda_depth
 
+        # Needle suppression (patches/3dgrut-needle.patch), on the activated per-axis scales s:
+        #  erank-GS (Hyung et al., NeurIPS 2024): erank = exp(H(q)), q_i = s_i^2 / sum s^2 (covariance eigenvalues);
+        #   relu(-log(erank - 1 + eps)) is > 0 only for erank < 2 and grows as one axis dominates (needle, erank -> 1)
+        #  anisotropy cap (PhysGaussian-style): relu(s_max / s_min - aniso_max)
+        loss_erank = torch.zeros(1, device=self.device)
+        loss_aniso = torch.zeros(1, device=self.device)
+        lambda_erank = float(self.conf.loss.get("lambda_erank", 0.0))
+        lambda_aniso = float(self.conf.loss.get("lambda_aniso", 0.0))
+        if (lambda_erank > 0 or lambda_aniso > 0) and not self._in_color_refine \
+                and self.global_step >= int(self.conf.loss.get("reg_start_iteration", 0)):
+            with torch.cuda.nvtx.range("loss-needle"):
+                s = self.model.get_scale()
+                if lambda_erank > 0:
+                    v = torch.square(s)
+                    q = v / v.sum(dim=1, keepdim=True).clamp_min(1e-30)
+                    erank = torch.exp(-(q * torch.log(q.clamp_min(1e-30))).sum(dim=1))
+                    loss_erank = torch.relu(-torch.log(erank - 1.0 + 1e-5)).mean()
+                if lambda_aniso > 0:
+                    ratio = s.max(dim=1).values / s.min(dim=1).values.clamp_min(1e-12)
+                    loss_aniso = torch.relu(ratio - float(self.conf.loss.get("aniso_max", 10.0))).mean()
+        else:
+            lambda_erank = lambda_aniso = 0.0
+
