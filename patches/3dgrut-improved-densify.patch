index 0000000..8483f25
--- /dev/null
+++ b/configs/apps/colmap_3dgut_improved.yaml
@@ -0,0 +1,21 @@
+# @package _global_
+
+# 3DGUT on COLMAP data with Improved-GS densification (configs/strategy/improved.yaml)
+defaults:
+  - /base_gs
+  - /dataset: colmap
+  - /initialization: colmap
+  - /render: 3dgut
+  - override /strategy: improved
+  - _self_
+
+val_frequency: 999999 # never validate
+
+# Improved-GS's position learning rate (4x lower than 3DGS; the reference uses it only for this method)
+optimizer:
+  params:
+    positions:
+      lr: 0.00004
+scheduler:
+  positions:
+    lr_final: 0.000002
diff --git a/configs/strategy/improved.yaml b/configs/strategy/improved.yaml
new file mode 100644
index 0000000..065d74a
--- /dev/null
+++ b/configs/strategy/improved.yaml
@@ -0,0 +1,54 @@
+# Improved-GS densification (threedgrut/strategy/improved.py; ImprovedGS Non-Commercial Research License).
+# Defaults are the reference implementation's (arguments/__init__.py); only `budget` is scene-dependent.
+method: ImprovedGSStrategy
+
+print_stats: true
+
+budget: 1000000 # Gaussian budget (reference: 1M indoor .. 3M large outdoor Mip-NeRF360 scenes)
+budget_warmup_until_offset: 500 # budget grows as sqrt(progress) until densify.end_iteration - this
+split_distance: 0.45 # long-axis split: children at +-3*split_distance*s_max
+opacity_reduction: 0.6 # children opacity = parent * this
+las: true # long-axis split (false: 3DGS split of gradient-qualified Gaussians)
+
+densify:
+  frequency: 100
+  start_iteration: 500
+  end_iteration: 15000
+  grad_threshold: 0.0003 # on the accumulated per-pixel absolute position gradient (AbsGS-style)
+  # used only by the las=false fallback (GSStrategy.split_gaussians) / GSStrategy.__init__
+  clone_grad_threshold: 0.0002
+  split_grad_threshold: 0.0002
+  relative_size_threshold: 0.01
+  split:
+    n_gaussians: 2
+
+prune:
+  density_threshold: 0.005 # opacity prune after each densification step
+
+eas: # edge-aware densification score
+  enabled: true
+  sample_cams: 10 # training views per densification step (rotating pool); -1 = all
+  full_pass_frequency: 3000 # ... all views when step % frequency == offset and step < until
+  full_pass_offset: 400
+  full_pass_until: 9000
+
+rap: # recovery-aware pruning
+  enabled: true
+  reset_frequency: 3000
+  reset_max_density: 0.05
+  prune_ratio: 0.2 # lowest-opacity share pruned prune_offset iterations after a reset
+  prune_offset: 300
+  rounds: 2
+  early_prune_iteration: 300
+  early_prune_threshold: 0.02
+
+mu: # late multi-step updates (optimizer step every `interval` iterations, gradients accumulate)
+  enabled: true
+  start_iteration: 20000
+  interval: 5
+  second_start_iteration: 24000
+  second_interval: 20
+
+# GSStrategy fields (unused by this strategy)
+reset_density:
+  new_max_density: 0.05
