diff --git a/threedgrut/strategy/improved.py b/threedgrut/strategy/improved.py
new file mode 100644
index 0000000..3384565
--- /dev/null
+++ b/threedgrut/strategy/improved.py
@@ -0,0 +1,310 @@
+# Port of the ImprovedGS densification strategy to 3DGRUT (modified from the original):
+#
+#   Improving Densification in 3D Gaussian Splatting for High-Fidelity Rendering (CVPR 2026 Findings)
+#   Xiaobin Deng, Changyu Diao, Min Li, Ruohan Yu, Duanqing Xu -- https://github.com/XiaoBin2001/Improved-GS
+#   Copyright (c) 2026 ImprovedGS authors and Zhejiang University.
+#   ImprovedGS Non-Commercial Research License: non-commercial research, education and evaluation use only.
+#
+# Reference files ported: scene/methods/densification_stage.py, densification_methods.py, pruning_methods.py,
+# scene/gaussian_model_densification.py (densify_and_prune_improved, long_axis_split, only_prune, reset_opacity),
+# scene/training_loop.py (should_run_parameter_update). Components and their switches (strategy.*):
+#   EAS  eas.enabled  edge-aware score: sampled training views are rendered with a Laplacian edge map of the
+#                     real image as pixel weight; per-Gaussian sum of w_pixel * T * alpha, min-max normalised per
+#                     view and averaged, decides WHICH gradient-qualified Gaussians are split
+#   LAS  las          long-axis split: two children offset +-3*0.45*s_max along the longest axis, long axis scaled
+#                     by 0.55 and the others by sqrt(1 - 0.45^2), opacity * 0.6 (no clone; every size splits)
+#   RAP  rap.enabled  recovery-aware pruning: opacity reset to <= 0.05 every 3000 it, then 300 it later the
+#                     lowest-opacity 20% are pruned (first 2 resets); plus an opacity < 0.02 prune at it 300
+#   budget            growth control: splits per step are capped by budget * sqrt(progress) (progress from
+#                     densify start to end - 500); only gradient-qualified Gaussians are candidates
+#   MU   mu.enabled   late multi-step updates: from 20k the optimizer steps every 5th it, from 24k every 20th
+#                     (gradients accumulate in between)
+# Differences forced by 3DGUT (no screen-space means): the candidate gradient is the per-pixel norm of dL/dpos
+# summed over pixels (accumulated in the 3DGUT backward kernel, threedgut_tracer.tracer.last_abs_position_grad)
+# times camera distance / 2 -- the same 3D->view conversion 3DGRUT's GSStrategy uses -- instead of
+# AbsGS's |dL/dx|,|dL/dy| in NDC; the per-Gaussian edge weight is obtained exactly by differentiating an
+# edge-weighted render of constant radiance w.r.t. the DC colour (d C_p / d c_i = T_i alpha_i).
+# Falls back to 3DGRUT's signed gradient norm when the renderer provides no absolute gradient (3DGRT).
+
+import math
+from typing import Optional
+
+import torch
+import torch.nn.functional as F
+
+from threedgrut.model.features import Features
+from threedgrut.model.model import MixtureOfGaussians
+from threedgrut.strategy.gs import GSStrategy
+from threedgrut.utils.logger import logger
+from threedgrut.utils.misc import quaternion_to_so3
+
+SH_C0 = 0.28209479177387814
+_FIND_EDGES_KERNEL = torch.tensor([[[-1.0, -1.0, -1.0], [-1.0, 8.0, -1.0], [-1.0, -1.0, -1.0]]]).unsqueeze(0)
+
+
+def normalize_to_unit_range(x: torch.Tensor) -> torch.Tensor:
+    x = torch.nan_to_num(x.detach().float(), nan=0.0, posinf=0.0, neginf=0.0)
+    if x.numel() == 0:
+        return x
+    lo, hi = x.amin(), x.amax()
+    return torch.zeros_like(x) if float(hi - lo) <= 0.0 else (x - lo) / (hi - lo)
+
+
+def compute_edge_map(rgb: torch.Tensor) -> torch.Tensor:
+    """[H, W, 3] in [0, 1] -> [H, W] edge weights in [0, 1] (8-bit grey, Laplacian 'find edges', min-max)."""
+    rgb = torch.round(rgb.detach().float().permute(2, 0, 1).unsqueeze(0)[:, :3] * 255.0)
+    grey = torch.round((299.0 * rgb[:, 0:1] + 587.0 * rgb[:, 1:2] + 114.0 * rgb[:, 2:3]) / 1000.0)
+    edge = F.conv2d(grey, _FIND_EDGES_KERNEL.to(grey.device), padding=1)
+    return normalize_to_unit_range(torch.clamp(edge, 0.0, 255.0) / 255.0)[0, 0]
+
+
+class _ConstantRadianceView:
+    """The model's geometry (detached) with caller-provided SH features, for the renderer's `gaussians` arg."""
+
+    def __init__(self, model: MixtureOfGaussians, features: torch.Tensor):
+        self._m, self._f = model, features
+        self.positions = model.positions.detach()
+        self.n_active_features = model.n_active_features
+        self.num_gaussians = model.num_gaussians
+        self.ray_feature_dim = model.ray_feature_dim
+
+    def get_rotation(self):
+        return self._m.get_rotation().detach()
+
+    def get_scale(self):
+        return self._m.get_scale().detach()
+
+    def get_density(self):
+        return self._m.get_density().detach()
+
+    def get_features(self):
+        return self._f
+
+
+class ImprovedGSStrategy(GSStrategy):
+    def __init__(self, config, model: MixtureOfGaussians) -> None:
+        super().__init__(config=config, model=model)
+        s = self.conf.strategy
+        self.grad_threshold = s.densify.grad_threshold
+        self.new_max_density = s.rap.reset_max_density  # used by GSStrategy.reset_density
+        self.rap_triggers: set[int] = set()
+        self.rap_reset_count = 0
+        self.edge_pool: list[int] = []
+        self.use_abs_grad: Optional[bool] = None
+        self.eas_checked = False
+        try:
+            from threedgut_tracer.tracer import last_abs_position_grad
+
+            self._abs_grad_fn = last_abs_position_grad
+        except ImportError:
+            self._abs_grad_fn = None
+
+    # ---------------------------------------------------------------- statistics (ImprovedGS: abs gradients)
+    def _in_densify_window(self, step: int) -> bool:
+        return self.conf.strategy.densify.start_iteration < step < self.conf.strategy.densify.end_iteration
+
+    def _post_backward(self, step: int, scene_extent: float, train_dataset, batch=None, writer=None) -> bool:
+        if self._in_densify_window(step):
+            with torch.cuda.nvtx.range(f"train_{step}_grad_buffer"):
+                self.update_gradient_buffer(sensor_position=batch.T_to_world[0, :3, 3])
+        if self.conf.model.density_activation == "none":
+            self.model.clamp_density()
+        return False
+
+    @torch.no_grad()
+    def update_gradient_buffer(self, sensor_position: torch.Tensor) -> None:
+        params_grad = self.model.positions.grad
+        assert params_grad is not None
+        mask = (params_grad != 0).max(dim=1)[0]
+        dist = (self.model.positions[mask] - sensor_position).norm(dim=1, keepdim=True)
+        abs_grad = self._abs_grad_fn() if self._abs_grad_fn is not None else None
+        if self.use_abs_grad is None:  # decided once: does this renderer accumulate |dL/dpos| per pixel?
+            self.use_abs_grad = bool(abs_grad is not None and abs_grad.shape[0] == params_grad.shape[0]
+                                     and float(abs_grad.abs().sum()) > 0)
+            logger.info(f"[ImprovedGS] candidate gradient: {'per-pixel absolute' if self.use_abs_grad else 'signed (fallback)'}")
+        if self.use_abs_grad:
+            g = abs_grad[mask] * dist / 2
+        else:
+            g = torch.norm(params_grad[mask] * dist, dim=-1, keepdim=True) / 2
+        self.densify_grad_norm_accum[mask] += g
+        self.densify_grad_norm_denom[mask] += 1
+
+    # ---------------------------------------------------------------- schedule
+    def should_step_optimizer(self, step: int) -> bool:
+        mu = self.conf.strategy.mu
+        if self._suspended or not mu.enabled or step < mu.start_iteration:
+            return True
+        if step < mu.second_start_iteration:
+            return step % max(int(mu.interval), 1) == 0
+        return step % max(int(mu.second_interval), 1) == 0
+
+    def _post_optimizer_step(self, step: int, scene_extent: float, train_dataset, batch=None, writer=None) -> bool:
+        s = self.conf.strategy
+        updated = False
+        if s.densify.frequency > 0 and self._in_densify_window(step) and step % s.densify.frequency == 0:
+            scores = self.edge_scores(step, train_dataset) if s.eas.enabled else None
+            self.densify_and_prune_improved(scores, step, scene_extent)
+            updated = True
+        # pruning stage (after densification, as in ImprovedGS's loop)
+        if s.rap.enabled:
+            if step == s.rap.early_prune_iteration:
+                self.prune_below(self.model.get_density().squeeze(-1) >= s.rap.early_prune_threshold, "early")
+                updated = True
+            if step in self.rap_triggers:
+                dens = self.model.get_density().detach().flatten()
+                thr = torch.quantile(dens, float(s.rap.prune_ratio)) if dens.numel() < 2**24 else \
+                    dens.kthvalue(max(int(dens.numel() * float(s.rap.prune_ratio)), 1)).values
+                self.prune_below(dens >= thr, "RAP")
+                self.rap_triggers.discard(step)
+                updated = True
+            if self._in_densify_window(step) and step % s.rap.reset_frequency == 0:
+                self.reset_density()
+                if s.rap.prune_ratio > 0 and self.rap_reset_count < s.rap.rounds:
+                    self.rap_triggers.add(step + int(s.rap.prune_offset))
+                self.rap_reset_count += 1
+                if s.print_stats:
+                    logger.info(f"[ImprovedGS] opacity reset to <= {self.new_max_density} at {step}")
+        return updated
+
+    def current_budget(self, step: int) -> int:
+        s = self.conf.strategy
+        budget = int(s.budget)
+        start, end = int(s.densify.start_iteration), int(s.densify.end_iteration) - int(s.budget_warmup_until_offset)
+        if end <= start:
+            return budget
+        progress = min(max((step - start) / float(end - start), 0.0), 1.0)
+        return budget if progress >= 1.0 else max(int(progress**0.5 * budget), 1)
+
+    # ---------------------------------------------------------------- EAS
+    def _accum_edge_weights(self, gpu_batch, edge: torch.Tensor):
+        """Per-Gaussian sum_p edge_p * T_i(p) * alpha_i(p) and the visibility mask for one view."""
+        m = self.model
+        feats = torch.zeros_like(m.get_features()).requires_grad_(True)  # radiance = max(0 + 0.5, 0) everywhere
+        with torch.enable_grad():
+            out = m.renderer.render(_ConstantRadianceView(m, feats), gpu_batch, train=True)
+            (out["pred_features"][0, ..., 0] * edge).sum().backward()
+        w = feats.grad[:, 0].detach() / SH_C0
+        vis = out["mog_visibility"].reshape(-1) > 0
+        if not self.eas_checked:  # sanity check once: sum_i w_i must equal the edge-weighted rendered opacity
+            ref = float((out["pred_opacity"][0, ..., 0].detach() * edge).sum())
+            logger.info(f"[ImprovedGS] EAS check: sum of per-Gaussian weights {float(w.sum()):.1f} vs "
+                        f"edge-weighted opacity {ref:.1f}")
+            self.eas_checked = True
+        return w, vis
+
+    def _sample_views(self, step: int, n_views: int) -> list[int]:
+        s = self.conf.strategy.eas
+        k = int(s.sample_cams)
+        if k == -1 or k >= n_views or (step % s.full_pass_frequency == s.full_pass_offset and step < s.full_pass_until):
+            return list(range(n_views))
+        out = []
+        for _ in range(k):  # rotating pool: every view is used once before any repeats
+            if not self.edge_pool:
+                self.edge_pool = list(range(n_views))
+            out.append(self.edge_pool.pop())
+        return out
+
+    def edge_scores(self, step: int, train_dataset) -> Optional[torch.Tensor]:
+        if self.model.feature_type != Features.Type.SH:
+            return None
+        ids = self._sample_views(step, len(train_dataset))
+        imp = torch.zeros(self.model.num_gaussians, device=self.model.device)
+        seen = torch.zeros_like(imp, dtype=torch.bool)
+        for i in ids:
+            gpu_batch = train_dataset.get_gpu_batch_with_intrinsics(torch.utils.data.default_collate([train_dataset[i]]))
+            w, vis = self._accum_edge_weights(gpu_batch, compute_edge_map(gpu_batch.rgb_gt[0]))
+            imp[vis] += normalize_to_unit_range(w)[vis] / max(len(ids), 1)
+            seen |= vis
+        return imp if bool(seen.any()) else None
+
+    # ---------------------------------------------------------------- densify / prune
+    def densify_and_prune_improved(self, scores: Optional[torch.Tensor], step: int, scene_extent: float) -> None:
+        s = self.conf.strategy
+        grads = self.densify_grad_norm_accum / self.densify_grad_norm_denom
+        grads[grads.isnan()] = 0.0
+        grads = grads.squeeze(-1)
+        budget = self.current_budget(step)
+        min_grad = float(self.grad_threshold)
+        late = max(int(s.densify.end_iteration) - 100, int(s.densify.start_iteration))
+        if scores is None or step > late:
+            scores = grads
+            if self.model.num_gaussians < budget and step > late:
+                min_grad = min_grad / 1.5
+        qualifiers = grads >= min_grad
+        n_cand, n_cur = int(qualifiers.sum()), self.model.num_gaussians
+        split_budget = min(budget, n_cand + n_cur) - n_cur
+        n_split = 0
+        if split_budget > 0:
+            if s.las:
+                n_split = self.long_axis_split(scores, split_budget, qualifiers)
+            else:
+                self.split_gaussians(torch.where(qualifiers, grads, torch.zeros_like(grads)), scene_extent)
+        if s.print_stats:
+            logger.info(f"[ImprovedGS] it {step}: budget {budget}, {n_cand} candidates, split {n_split} -> "
+                        f"{self.model.num_gaussians}")
+        if step < late:
+            self.prune_below(self.model.get_density().squeeze(-1) >= self.prune_density_threshold, "density")
+        torch.cuda.empty_cache()
+
+    @torch.no_grad()
+    def long_axis_split(self, scores: torch.Tensor, budget: int, filter_mask: torch.Tensor) -> int:
+        s = self.conf.strategy
+        n = self.model.num_gaussians
+        imp = torch.zeros(n, dtype=torch.float32, device=self.model.device)
+        imp[: scores.shape[0]] = scores.detach().float().clamp_min(0)
+        imp[~filter_mask] = 0
+        n_pos = int((imp > 0).sum())
+        if budget <= 0 or n_pos == 0:
+            return 0
+        budget = min(int(budget), n_pos)
+        mask = torch.zeros(n, dtype=torch.bool, device=imp.device)
+        mask[torch.multinomial(imp, budget, replacement=False)] = True
+
+        d = float(s.split_distance)
+        stds = self.model.get_scale()[mask]
+        max_v, max_i = torch.max(stds, dim=1, keepdim=True)
+        axis = torch.zeros_like(stds, dtype=torch.bool).scatter(1, max_i, True)
+        offsets = stds * axis * 3.0 * d
+        offsets = torch.cat([offsets, -offsets], dim=0)
+        rots = quaternion_to_so3(self.model.rotation[mask]).repeat(2, 1, 1)
+        new_pos = torch.bmm(rots, offsets.unsqueeze(-1)).squeeze(-1) + self.model.positions[mask].repeat(2, 1)
+        rate_w, rate_h = max(1.0 - d, 1e-6), math.sqrt(max(1.0 - d * d, 1e-6))
+        new_scale = self.model.scale_activation_inv(stds.scatter(1, max_i, max_v * rate_w / rate_h).repeat(2, 1) * rate_h)
+        new_density = self.model.density_activation_inv(
+            self.model.get_density()[mask] * float(s.opacity_reduction)).repeat(2, 1)
+        k = int(mask.sum())
+
+        def update_param_fn(name: str, param: torch.Tensor) -> torch.Tensor:
+            if name == "positions":
+                child = new_pos
+            elif name == "scale":
+                child = new_scale
+            elif name == "density":
+                child = new_density
+            else:
