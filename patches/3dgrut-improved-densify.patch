+    @torch.no_grad()
+    def prune_below(self, keep: torch.Tensor, label: str) -> None:
+        if bool(keep.all()):
+            return
+        if self.conf.strategy.print_stats:
+            n, p = keep.shape[0], int((~keep).sum())
+            logger.info(f"[ImprovedGS] {label}-pruned {p} / {n} ({p / n * 100:.2f}%) gaussians")
+
+        def update_param_fn(name: str, param: torch.Tensor) -> torch.Tensor:
+            return torch.nn.Parameter(param[keep], requires_grad=param.requires_grad)
+
+        def update_optimizer_fn(key: str, v: torch.Tensor) -> torch.Tensor:
+            return v[keep]
+
+        self._update_param_with_optimizer(update_param_fn, update_optimizer_fn)
+        self.prune_densification_buffers(keep)
