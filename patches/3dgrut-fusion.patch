@@ -0,0 +1,80 @@
+# Fusion of several recordings (CEAR patch, patches/3dgrut-fusion.patch): per-recording / per-frame colour
+# transforms applied to the render during training only, and per-frame valid-pixel masks for the loss.
+import json
+import os
+
+import numpy as np
+import torch
+import torch.nn as nn
+from PIL import Image
+
+
+def recording_of(path: str) -> str:
+    """Recording = the image's sub-folder inside the dataset's image folder (fuse_sequences.py layout)."""
+    return os.path.basename(os.path.dirname(str(path)))
+
+
+class RecordingAppearance(nn.Module):
+    """y = A_k x + b_k on the rendered RGB of training frame k's recording (mode=recording) or of frame k itself
+    (mode=frame). Frames of the reference recording use the identity (not learnt), so the splat stays in the
+    reference recording's colours and the transforms only absorb the other recordings' exposure / white balance."""
+
+    def __init__(self, image_paths, mode="recording", model="affine", reference=""):
+        super().__init__()
+        recs = [recording_of(p) for p in image_paths]
+        self.recordings = sorted(set(recs))
+        self.reference = reference or self.recordings[0]
+        if self.reference not in self.recordings:
+            raise ValueError(f"appearance.reference '{self.reference}' is not one of {self.recordings}")
+        self.mode, self.model_kind, self.names = mode, model, [str(p) for p in image_paths]
+        keys = self.recordings if mode == "recording" else [str(i) for i in range(len(recs))]
+        self.key_names = keys if mode == "recording" else self.names
+        ref = [k == self.reference for k in keys] if mode == "recording" else [r == self.reference for r in recs]
+        rec_idx = {r: i for i, r in enumerate(self.recordings)}
+        # frame -> parameter slot
+        slot = [rec_idx[r] for r in recs] if mode == "recording" else list(range(len(recs)))
+        self.register_buffer("slot", torch.tensor(slot, dtype=torch.long))
+        self.register_buffer("is_ref", torch.tensor(ref, dtype=torch.bool))
+        n = len(keys)
+        if model == "affine":
+            self.A = nn.Parameter(torch.eye(3).repeat(n, 1, 1))
+        elif model == "gain":
+            self.A = nn.Parameter(torch.ones(n, 3))
+        else:
+            raise ValueError(f"unknown appearance.model {model}")
+        self.b = nn.Parameter(torch.zeros(n, 3))
+
+    def forward(self, rgb: torch.Tensor, frame_idx: int) -> torch.Tensor:
+        k = int(self.slot[frame_idx])
+        if bool(self.is_ref[k]):
+            return rgb
+        A = self.A[k] if self.model_kind == "affine" else torch.diag(self.A[k])
+        return rgb @ A.T + self.b[k]
+
+    def to_json(self, path: str, step: int):
+        out = {"mode": self.mode, "model": self.model_kind, "reference": self.reference, "step": int(step),
+               "recordings": self.recordings, "transforms": {}}
+        with torch.no_grad():
+            for k, name in enumerate(self.key_names):
+                if bool(self.is_ref[k]):
+                    continue
+                A = self.A[k] if self.model_kind == "affine" else torch.diag(self.A[k])
+                out["transforms"][name] = {"A": A.cpu().numpy().round(5).tolist(), "b": self.b[k].cpu().numpy().round(5).tolist()}
+        json.dump(out, open(path, "w"), indent=1)
+
+
+class ValidMasks:
+    """<image stem><suffix> per training frame, loaded lazily and cached as [1, H, W, 1] float in [0, 1]."""
+
+    def __init__(self, image_paths, suffix="_valid.png", device="cuda"):
+        self.paths = [os.path.splitext(str(p))[0] + suffix for p in image_paths]
+        self.present = np.array([os.path.exists(p) for p in self.paths])
+        self.device, self.cache = device, {}
+
+    def __call__(self, frame_idx: int):
+        if not self.present[frame_idx]:
+            return None
+        if frame_idx not in self.cache:
+            m = np.asarray(Image.open(self.paths[frame_idx]).convert("L"), dtype=np.uint8)
+            self.cache[frame_idx] = torch.from_numpy(m)[None, :, :, None]
+        return self.cache[frame_idx].to(self.device, non_blocking=True).float() / 255.0
