diff --git a/threedgrut/freespace.py b/threedgrut/freespace.py
new file mode 100644
index 0000000..3deeb00
--- /dev/null
+++ b/threedgrut/freespace.py
@@ -0,0 +1,75 @@
+# LiDAR free-space prior for floater suppression (CEAR patch, patches/3dgrut-freespace.patch).
+#
+# The grid comes from scripts/build_freespace_grid.py: per-voxel scan counts in the LiDAR's metric frame,
+#   free[v]  scans whose beam crossed v before its return (minus a margin)
+#   hit[v]   scans with a return inside v
+# plus the COLMAP->metric sim3 (x_m = s R x + t). A voxel is confidently free when free >= min_free and no
+# hit lies within `dilate` voxels; voxels no beam crossed are unknown and never count as free. Gaussian
+# centres (training frame) are mapped through the sim3 and looked up in that boolean grid.
+
+import json
+import os
+
+import numpy as np
+import torch
+import torch.nn.functional as F
+
+from threedgrut.utils.logger import logger
+
+
+class FreeSpaceGrid:
+    def __init__(self, path: str, min_free: int, dilate: int, device):
+        z = np.load(path)
+        free, hit = torch.from_numpy(z["free"].astype(np.int32)), torch.from_numpy(z["hit"].astype(np.float32))
+        occ = hit > 0
+        if dilate > 0:  # protect a shell around every LiDAR return
+            occ = F.max_pool3d(occ.float()[None, None], 2 * dilate + 1, stride=1, padding=dilate)[0, 0] > 0
+        self.mask = ((free >= min_free) & ~occ).to(device)
+        self.dims = torch.tensor(self.mask.shape, device=device)
+        self.origin = torch.tensor(z["origin"], dtype=torch.float32, device=device)
+        self.voxel = float(z["voxel"])
+        s, R, t = float(z["sim3_s"]), torch.tensor(z["sim3_R"], dtype=torch.float32), torch.tensor(z["sim3_t"], dtype=torch.float32)
+        self.A, self.b = (s * R).T.contiguous().to(device), t.to(device)  # x_m = x @ A + b
+        meta = json.loads(str(z["meta"])) if "meta" in z else {}
+        logger.info(f"FreeSpace: {os.path.basename(path)}: {tuple(self.mask.shape)} voxels of {self.voxel:.3f} m, "
+                    f"{int(self.mask.sum())} confidently free (free >= {min_free}, hit dilation {dilate}), "
+                    f"{meta.get('scans', '?')} scans")
+
+    @torch.no_grad()
+    def query(self, positions: torch.Tensor) -> torch.Tensor:
+        """[N, 3] centres in the training (COLMAP) frame -> [N] bool: inside confidently free space."""
+        ijk = torch.floor((positions.detach().float() @ self.A + self.b - self.origin) / self.voxel).long()
+        ok = ((ijk >= 0) & (ijk < self.dims)).all(dim=1)
+        out = torch.zeros(positions.shape[0], dtype=torch.bool, device=positions.device)
+        i = ijk[ok]
+        out[ok] = self.mask[i[:, 0], i[:, 1], i[:, 2]]
+        return out
+
+
+def load_freespace(conf, device):
+    """FreeSpaceGrid from conf.freespace, or None when disabled / the grid file is absent (auto-skip)."""
+    fs = conf.get("freespace", None)
+    path = fs.get("grid_path", "") if fs is not None else ""
+    if not path:
+        return None
+    if not os.path.exists(path):
+        logger.warning(f"FreeSpace: grid {path} not found: free-space prior off")
+        return None
+    return FreeSpaceGrid(path, int(fs.get("min_free", 3)), int(fs.get("dilate", 1)), device)
+
+
+@torch.no_grad()
+def prune_gaussians(strategy, keep: torch.Tensor) -> bool:
+    """Remove gaussians (keep=False) through the strategy's optimizer-aware update; GS-family strategies only."""
+    if not (hasattr(strategy, "_update_param_with_optimizer") and hasattr(strategy, "prune_densification_buffers")):
+        return False
+
+    def update_param_fn(name: str, param: torch.Tensor) -> torch.Tensor:
+        return torch.nn.Parameter(param[keep], requires_grad=param.requires_grad)
+
+    def update_optimizer_fn(key: str, v: torch.Tensor) -> torch.Tensor:
+        return v[keep]
+
+    strategy._update_param_with_optimizer(update_param_fn, update_optimizer_fn)
+    strategy.prune_densification_buffers(keep)
+    return True
